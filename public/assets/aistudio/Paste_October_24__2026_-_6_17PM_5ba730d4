  var sliderProgressFill = document.getElementById("slider-progress-fill");
  var sliderHintTxt = document.getElementById("slider-hint-txt");

  var isDragging = false;
  var hasDragged = false;
  var startX = 0;
  var scrollStart = 0;

  var activeModal = null;
  var lastFocusedEl = null;

  function renderCategoryModalContent(catKey) {
    if(!catKey) return;
    var data = I18N[currentLang].cards[catKey];
    if(!data) return;
    var d = I18N[currentLang];

    if(catModalTitle) catModalTitle.textContent = data.title;
    if(catModalDesc) catModalDesc.textContent = data.desc;
    if(catModalTags) {
      catModalTags.innerHTML = "";
      data.tags.forEach(function(tag){
        var span = document.createElement("span");
        span.className = "cat-tag";
        span.textContent = tag;
        catModalTags.appendChild(span);
      });
    }

    var gallery = categoryGalleries[catKey] || [categoryImages[catKey]];
    var totalPhotos = gallery.length;

    if(catModalCount) {
      catModalCount.textContent = totalPhotos + " " + (d.catPhotosSuffix || (currentLang === "vi" ? "tác phẩm" : "photos"));
    }

    var catScrollPromptTxt = document.getElementById("cat-scroll-prompt-txt");
    if(catScrollPromptTxt && d.catScrollPrompt) catScrollPromptTxt.textContent = d.catScrollPrompt;

    var catStreamEndTxt = document.getElementById("cat-stream-end-txt");
    if(catStreamEndTxt && d.catStreamEnd) catStreamEndTxt.textContent = d.catStreamEnd;

    var catStreamTopTxt = document.getElementById("cat-stream-top-txt");
    if(catStreamTopTxt && d.catStreamTop) catStreamTopTxt.textContent = d.catStreamTop;

    var catBookBtnTxt = document.getElementById("cat-book-btn-txt");
    if(catBookBtnTxt && d.catBookBtn) catBookBtnTxt.textContent = d.catBookBtn;

    if(catStream) {
      catStream.innerHTML = "";
      gallery.forEach(function(imgSrc, index) {
        var figure = document.createElement("figure");
        figure.className = "cat-stream-item" + (index === 0 ? " is-first-thumb" : "");

        var wrap = document.createElement("div");
        wrap.className = "cat-stream-img-wrap";

        var img = document.createElement("img");
        img.className = "cat-stream-img";
        img.src = encodeURI(imgSrc);
        img.alt = data.name + " " + (index + 1);
        img.loading = index < 2 ? "eager" : "lazy";
        img.decoding = "async";

        wrap.appendChild(img);
        figure.appendChild(wrap);
        catStream.appendChild(figure);
      });
    }
  }

  function setLanguage(lang) {
    if(lang !== "vi" && lang !== "en") return;
    currentLang = lang;
    try {
      localStorage.setItem("february_lang", lang);
    } catch(e){}

    document.documentElement.lang = lang;
    var d = I18N[lang];
    document.title = d.pageTitle;

    // Toggle button active state
    if(tagVi) tagVi.classList.toggle("active", lang === "vi");
    if(tagEn) tagEn.classList.toggle("active", lang === "en");

    // Nav & CTAs
    var txtNavAbout = document.getElementById("txt-nav-about");
    if(txtNavAbout) txtNavAbout.textContent = d.navAbout;

    var txtCopyTl = document.getElementById("txt-copy-tl");
    if(txtCopyTl) txtCopyTl.textContent = d.copyTl;

    var txtCopyTr = document.getElementById("txt-copy-tr");
    if(txtCopyTr) txtCopyTr.textContent = d.copyTr;

    var txtCopyBl1 = document.getElementById("txt-copy-bl-1");
    if(txtCopyBl1) txtCopyBl1.textContent = d.copyBl1;
    var txtCopyBl2 = document.getElementById("txt-copy-bl-2");
    if(txtCopyBl2) txtCopyBl2.textContent = d.copyBl2;

    var txtCopyBr1 = document.getElementById("txt-copy-br-1");
    if(txtCopyBr1) txtCopyBr1.textContent = d.copyBr1;
    var txtCopyBr2 = document.getElementById("txt-copy-br-2");
    if(txtCopyBr2) txtCopyBr2.textContent = d.copyBr2;

    var txtCtaView = document.getElementById("txt-cta-view");
    if(txtCtaView) txtCtaView.textContent = d.ctaView;

    var txtCtaContact = document.getElementById("txt-cta-contact");
    if(txtCtaContact) txtCtaContact.textContent = d.ctaContact;

    // Contact modal
    var contactTitleEl = document.getElementById("contact-title");
    if(contactTitleEl) contactTitleEl.textContent = d.contactTitle;

    // About modal
    var aboutTitleEl = document.getElementById("about-title");
    if(aboutTitleEl && d.aboutTitle) aboutTitleEl.textContent = d.aboutTitle;

    var aboutNameEl = document.getElementById("about-name");
    if(aboutNameEl && d.aboutName) aboutNameEl.textContent = d.aboutName;

    var aboutRoleEl = document.getElementById("about-role");
    if(aboutRoleEl && d.aboutRole) aboutRoleEl.textContent = d.aboutRole;

    var aboutLocEl = document.getElementById("about-loc");
    if(aboutLocEl && d.aboutLoc) aboutLocEl.textContent = d.aboutLoc;

    var aboutIntroEl = document.getElementById("about-intro-p");
    if(aboutIntroEl && d.aboutIntro) aboutIntroEl.innerHTML = d.aboutIntro;

    var aboutExpHeadingEl = document.getElementById("about-exp-heading");
    if(aboutExpHeadingEl && d.aboutExpHeading) aboutExpHeadingEl.textContent = d.aboutExpHeading;

    var aboutGroupListEl = document.getElementById("about-group-list");
    if(aboutGroupListEl && Array.isArray(d.aboutGroups)) {
      aboutGroupListEl.innerHTML = "";
      d.aboutGroups.forEach(function(grp){
        var grpDiv = document.createElement("div");
        grpDiv.className = "about-exp-group";
        var h4 = document.createElement("h4");
        h4.className = "about-group-title";
        h4.textContent = grp.title;
        grpDiv.appendChild(h4);
        grp.items.forEach(function(itemHtml){
          var itemDiv = document.createElement("div");
          itemDiv.className = "about-exp-item";
          itemDiv.innerHTML = itemHtml;
          grpDiv.appendChild(itemDiv);
        });
        aboutGroupListEl.appendChild(grpDiv);
      });
    }

    var aboutStyleTitleEl = document.getElementById("about-style-title");
    if(aboutStyleTitleEl && d.aboutStyleTitle) aboutStyleTitleEl.textContent = d.aboutStyleTitle;

    var aboutStyleTextEl = document.getElementById("about-style-text");
    if(aboutStyleTextEl && d.aboutStyleText) aboutStyleTextEl.textContent = d.aboutStyleText;

    var aboutBtnContactTxtEl = document.getElementById("about-btn-contact-txt");
    if(aboutBtnContactTxtEl && d.aboutBtnContact) aboutBtnContactTxtEl.textContent = d.aboutBtnContact;

    var aboutToolsLabelEl = document.getElementById("about-tools-label");
    if(aboutToolsLabelEl && d.aboutToolsLabel) aboutToolsLabelEl.textContent = d.aboutToolsLabel;

    // Products Section Header
    var prodKickerEl = document.getElementById("prod-kicker");
    if(prodKickerEl) prodKickerEl.textContent = d.prodKicker;

    var prodTitleEl = document.getElementById("prod-title");
    if(prodTitleEl) prodTitleEl.textContent = d.prodTitle;

    var prodDescEl = document.getElementById("prod-desc");
    if(prodDescEl) prodDescEl.textContent = d.prodDesc;

    if(sliderHintTxt && d.sliderHint) {
      sliderHintTxt.textContent = d.sliderHint;
    }

    var backTopBtnEl = document.getElementById("back-top-btn");
    if(backTopBtnEl) backTopBtnEl.textContent = d.backTop;

    var catBookBtnEl = document.getElementById("cat-book-btn");
    if(catBookBtnEl) catBookBtnEl.textContent = d.catBookBtn;

    // All Product Cards
    var productCards = document.querySelectorAll(".product-card");
    productCards.forEach(function(card){
      var catKey = card.getAttribute("data-cat");
      if(d.cards[catKey]) {
        var cardInfo = d.cards[catKey];
        var idxEl = card.querySelector(".card-idx");
        if(idxEl) idxEl.textContent = cardInfo.idx;

        var nameEl = card.querySelector(".card-name");
        if(nameEl) nameEl.textContent = cardInfo.name;

        var taglineEl = card.querySelector(".card-tagline");
        if(taglineEl && cardInfo.tagline) taglineEl.textContent = cardInfo.tagline;

        var actionEl = card.querySelector(".card-action");
        if(actionEl) actionEl.innerHTML = d.cardAction;

        card.setAttribute("aria-label", cardInfo.name);
      }
    });

    // Update opened category modal if visible
    if(activeCategoryKey && catModal && catModal.classList.contains("open")) {
      renderCategoryModalContent(activeCategoryKey);
    }
  }

  // Language switch listeners
  if(langToggleBtn) {
    langToggleBtn.addEventListener("click", function(e){
      var targetTag = e.target.closest(".lang-tag");
      if(targetTag && targetTag.dataset.lang) {
        setLanguage(targetTag.dataset.lang);
      } else {
        setLanguage(currentLang === "vi" ? "en" : "vi");
      }
    });
  }

  // Modal show / hide
  function showModal(modal, triggerEl) {
    if(!modal) return;
    if(activeModal && activeModal !== modal) {
      hideModal(activeModal, false);
    }
    lastFocusedEl = triggerEl || document.activeElement;
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    activeModal = modal;

    var closeBtn = modal.querySelector(".modal-close");
    if(closeBtn) closeBtn.focus();
  }

  function hideModal(modal, restoreFocus) {
    if(!modal) return;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    if(activeModal === modal) activeModal = null;
    if(modal === catModal) activeCategoryKey = null;
    if(restoreFocus !== false && lastFocusedEl && typeof lastFocusedEl.focus === "function") {
      lastFocusedEl.focus();
    }
  }

  // Contact Modal
  if(contactBtn) {
    contactBtn.addEventListener("click", function(){ showModal(contactModal, contactBtn); });
  }
  if(contactClose) {
    contactClose.addEventListener("click", function(){ hideModal(contactModal); });
  }

  // About Me Modal
  if(aboutBtn) {
    aboutBtn.addEventListener("click", function(){ showModal(aboutModal, aboutBtn); });
  }
  if(aboutClose) {
    aboutClose.addEventListener("click", function(){ hideModal(aboutModal); });
  }

  var aboutToContactBtn = document.getElementById("about-to-contact-btn");
  if(aboutToContactBtn) {
    aboutToContactBtn.addEventListener("click", function(){
      hideModal(aboutModal, false);
      showModal(contactModal, contactBtn);
    });
  }

  // Dynamic Background Elements for Projects Section
  var bgLayerA = document.getElementById("products-bg-layer-a");
  var bgLayerB = document.getElementById("products-bg-layer-b");
  var activeLayerIsA = true;
  var currentBgKey = "wedding";

  if(bgLayerA && categoryImages["wedding"]) {
    bgLayerA.style.backgroundImage = "url('" + categoryImages["wedding"] + "')";
    bgLayerA.classList.add("is-active");
  }

  function setProjectBackground(catKey) {
    if(!catKey || catKey === currentBgKey) return;
    currentBgKey = catKey;
    var nextImgUrl = categoryImages[catKey];
    if(!nextImgUrl) return;

    if(activeLayerIsA) {
      if(bgLayerB) {
        bgLayerB.style.backgroundImage = "url('" + nextImgUrl + "')";
        bgLayerB.classList.add("is-active");
      }
      if(bgLayerA) bgLayerA.classList.remove("is-active");
      activeLayerIsA = false;
    } else {
      if(bgLayerA) {
        bgLayerA.style.backgroundImage = "url('" + nextImgUrl + "')";
        bgLayerA.classList.add("is-active");
      }
      if(bgLayerB) bgLayerB.classList.remove("is-active");
      activeLayerIsA = true;
    }
  }

  // Smooth centering function
  function centerCard(card) {
    if(!track || !card) return;
    var targetLeft = card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2;
    track.scrollTo({ left: targetLeft, behavior: "smooth" });
  }

  // Product cards trigger:
  // If card is not centered, click centers it; if already centered, opens category modal!
  var productCards = document.querySelectorAll(".product-card");
  productCards.forEach(function(card){
    card.addEventListener("click", function(e){
      if(hasDragged) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if(!card.classList.contains("is-active")) {
        e.preventDefault();
        centerCard(card);
        return;
      }
      var catKey = card.getAttribute("data-cat");
      activeCategoryKey = catKey;
      renderCategoryModalContent(catKey);
      if(catModalCard) catModalCard.scrollTop = 0;
      showModal(catModal, card);
    });
  });

  if(catClose) {
    catClose.addEventListener("click", function(){ hideModal(catModal); });
  }

  if(catStreamBackTop) {
    catStreamBackTop.addEventListener("click", function(){
      if(catModalCard) catModalCard.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  // Direct booking button inside Category Modal -> switches to Contact Modal
  if(catBookBtn) {
    catBookBtn.addEventListener("click", function(){
      hideModal(catModal, false);
      showModal(contactModal, contactBtn);
    });
  }

  // Backdrop clicks for all modals
  [contactModal, aboutModal, catModal].forEach(function(modal){
    if(!modal) return;
    modal.addEventListener("click", function(e){
      if(e.target === modal) hideModal(modal);
    });
  });

  // Global Escape key
  window.addEventListener("keydown", function(e){
    if(e.key === "Escape" && activeModal) {
      hideModal(activeModal);
    }
  });

  // Smooth Scroll Handlers
  if(viewProductBtn) {
    viewProductBtn.addEventListener("click", function(e){
      e.preventDefault();
      var prodSection = document.getElementById("products");
      if(prodSection) {
        prodSection.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  if(backTopBtn) {
    backTopBtn.addEventListener("click", function(){
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  // Horizontal Carousel Track Logic with Centering & Cross-fading Blurred Backdrop
  var currentActiveCardIndex = 0;

  function updateSliderState() {
    if(!track) return;
    var cards = track.querySelectorAll(".product-card");
    if(!cards.length) return;
    var trackCenter = track.scrollLeft + track.clientWidth / 2;
    var closestIdx = 0;
    var minDiff = Infinity;
    cards.forEach(function(c, i){
      var cCenter = c.offsetLeft + c.offsetWidth / 2;
      var diff = Math.abs(cCenter - trackCenter);
      if(diff < minDiff) {
        minDiff = diff;
        closestIdx = i;
      }
    });

    if(closestIdx !== currentActiveCardIndex) {
      currentActiveCardIndex = closestIdx;
      cards.forEach(function(c, i){
        if(i === closestIdx) {
          c.classList.add("is-active");
        } else {
          c.classList.remove("is-active");
        }
      });
      var activeCat = cards[closestIdx].getAttribute("data-cat");
      setProjectBackground(activeCat);
    }

    if(sliderCurrNum) {
      sliderCurrNum.textContent = (closestIdx + 1 < 10 ? "0" : "") + (closestIdx + 1);
    }

    if(sliderProgressFill) {
      var maxScroll = track.scrollWidth - track.clientWidth;
      var pct = maxScroll > 0 ? (track.scrollLeft / maxScroll) : 0;
      var barWidth = 100 / cards.length;
      sliderProgressFill.style.width = barWidth + "%";
      sliderProgressFill.style.transform = "translateX(" + (pct * (cards.length - 1) * 100) + "%)";
    }
  }

  function scrollSlider(direction) {
    if(!track) return;
    var cards = track.querySelectorAll(".product-card");
    var nextIdx = Math.max(0, Math.min(cards.length - 1, currentActiveCardIndex + direction));
    centerCard(cards[nextIdx]);
  }

  if(sliderPrevBtn) sliderPrevBtn.addEventListener("click", function(){ scrollSlider(-1); });
  if(sliderNextBtn) sliderNextBtn.addEventListener("click", function(){ scrollSlider(1); });

  if(track) {
    track.addEventListener("scroll", updateSliderState, { passive: true });

    // Desktop Mouse Drag to Scroll
    track.addEventListener("mousedown", function(e){
      if(e.button !== 0) return;
      isDragging = true;
      hasDragged = false;
      startX = e.pageX - track.offsetLeft;
      scrollStart = track.scrollLeft;
      track.classList.add("is-dragging");
    });

    window.addEventListener("mousemove", function(e){
      if(!isDragging || !track) return;
      var x = e.pageX - track.offsetLeft;
      var diff = (x - startX);
      if(Math.abs(diff) > 6) {
        hasDragged = true;
      }
      track.scrollLeft = scrollStart - diff * 1.35;
    });

    window.addEventListener("mouseup", function(){
      if(isDragging && track) {
        isDragging = false;
        track.classList.remove("is-dragging");
        setTimeout(function(){ hasDragged = false; }, 60);
      }
    });

    // Mouse Wheel to Horizontal Scroll
    track.addEventListener("wheel", function(e){
      if(Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        var canScrollLeft = track.scrollLeft > 0;
        var canScrollRight = track.scrollLeft < (track.scrollWidth - track.clientWidth - 4);
        if((e.deltaY > 0 && canScrollRight) || (e.deltaY < 0 && canScrollLeft)) {
          e.preventDefault();
          track.scrollLeft += e.deltaY * 0.95;
        }
      }
    }, { passive: false });
  }

  // Initialize Language & Slider state on Page Load
  setLanguage(currentLang);
  updateSliderState();
})();
</script>
</body>
</html>
